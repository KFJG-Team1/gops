{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gops.local/contracts/chart-czardas-pack.schema.json",
  "title": "GOPS Czardas v4 Present-Snapshot Field Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithmVersion", "configVersion", "inputContractVersion", "timeContractVersion",
    "calendarVersion", "inferenceConfigDigest", "projectionConfigDigest", "sightProjectionVersion",
    "sightProjectionId", "inferenceId", "symbol", "interval", "asOf", "lastCandleKey",
    "inputDigest", "status", "coverage", "selection", "boundaries", "patternRelations",
    "drawings", "czardasField", "rejectSummary"
  ],
  "properties": {
    "algorithmVersion": {"const": "czardas-v4"},
    "configVersion": {"const": "czardas-config-v4"},
    "inputContractVersion": {"const": "canonical-ohlcv-q8-v1"},
    "timeContractVersion": {"const": "market-time-v1"},
    "calendarVersion": {"const": "nyse-calendar-v1"},
    "inferenceConfigDigest": {"$ref": "#/$defs/digest"},
    "projectionConfigDigest": {"$ref": "#/$defs/digest"},
    "sightProjectionVersion": {"const": "czardas-sight-v3"},
    "sightProjectionId": {"$ref": "#/$defs/digest"},
    "inferenceId": {"$ref": "#/$defs/digest"},
    "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]*$"},
    "interval": {"$ref": "#/$defs/interval"},
    "asOf": {"$ref": "#/$defs/timestamp"},
    "lastCandleKey": {"type": "string", "minLength": 1},
    "inputDigest": {"$ref": "#/$defs/digest"},
    "status": {"const": "ready"},
    "coverage": {
      "type": "object",
      "required": ["state", "targetCompleted", "actualCompleted", "analysisBars", "qualityFlags"],
      "properties": {
        "state": {"const": "exact"}, "targetCompleted": {"const": 240},
        "actualCompleted": {"const": 240}, "analysisBars": {"const": 240},
        "qualityFlags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["hline", "trend", "pattern"],
      "properties": {
        "hline": {"$ref": "#/$defs/selectionCount"},
        "trend": {"$ref": "#/$defs/selectionCount"},
        "pattern": {"$ref": "#/$defs/selectionCount"}
      }
    },
    "boundaries": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/boundary"}},
    "patternRelations": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/patternRelation"}},
    "drawings": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"$ref": "#/$defs/drawing"}},
    "czardasField": {"$ref": "#/$defs/field"},
    "rejectSummary": {"type": "object"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "interval": {"enum": ["1m", "5m", "10m", "1h", "4h", "1D", "1W"]},
    "anchor": {
      "type": "object", "additionalProperties": false, "required": ["timestamp", "price"],
      "properties": {"timestamp": {"$ref": "#/$defs/timestamp"}, "price": {"type": "number"}}
    },
    "selectionCount": {
      "type": "object", "additionalProperties": false, "required": ["configuredCount", "actualCount"],
      "properties": {
        "configuredCount": {"type": ["integer", "null"]},
        "actualCount": {"type": "integer", "minimum": 0}
      }
    },
    "boundary": {
      "type": "object",
      "required": [
        "candidateId", "kind", "role", "evidenceState", "isRelevantNow", "line",
        "formation", "responses", "rank", "explanation"
      ],
      "properties": {
        "candidateId": {"$ref": "#/$defs/digest"},
        "kind": {"enum": ["hline", "trend"]},
        "role": {"enum": ["support", "resistance", "lower", "upper"]},
        "evidenceState": {"enum": ["formed", "response_supported", "baseline_memory"]},
        "isRelevantNow": {"type": "boolean"},
        "line": {"type": "object"}, "formation": {"type": "object"},
        "responses": {"type": "object"}, "rank": {"type": "object"}, "explanation": {"type": "object"}
      }
    },
    "patternRelation": {
      "type": "object",
      "allOf": [{
        "if": {"properties": {"kind": {"enum": ["flag", "pennant"]}}},
        "then": {"required": ["impulse"]}
      }],
      "required": [
        "relationId", "kind", "displayName", "boundaryCandidateIds", "domain",
        "relationQuality", "traceRef", "traceAnchorCount", "traceFactCount", "explanation"
      ],
      "properties": {
        "relationId": {"$ref": "#/$defs/digest"},
        "kind": {"enum": ["triangle", "channel", "rectangle", "wedge", "flag", "pennant"]},
        "displayName": {"type": "string", "minLength": 1},
        "boundaryCandidateIds": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        },
        "domain": {
          "type": "object", "required": ["fromTimestamp", "toTimestamp"],
          "properties": {
            "fromTimestamp": {"$ref": "#/$defs/timestamp"},
            "toTimestamp": {"$ref": "#/$defs/timestamp"}
          }
        },
        "impulse": {"$ref": "#/$defs/impulse"},
        "relationQuality": {"type": "number"},
        "traceRef": {"$ref": "#/$defs/digest"},
        "traceAnchorCount": {"type": "integer", "minimum": 3, "maximum": 16},
        "traceFactCount": {"type": "integer", "minimum": 3},
        "explanation": {"type": "object"}
      }
    },
    "impulse": {
      "type": "object",
      "required": ["factId", "fromTimestamp", "toTimestamp", "direction", "normalizedMove", "pathEfficiency"],
      "properties": {
        "factId": {"$ref": "#/$defs/digest"},
        "fromTimestamp": {"$ref": "#/$defs/timestamp"},
        "toTimestamp": {"$ref": "#/$defs/timestamp"},
        "direction": {"enum": [-1, 1]},
        "normalizedMove": {"type": "number"},
        "pathEfficiency": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "drawing": {
      "type": "object",
      "required": [
        "id", "type", "anchors", "sourceInterval", "style", "visible",
        "createdBy", "ownership", "czardasLayer", "sourceInferenceId", "createdAt", "updatedAt"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^czardas:"},
        "type": {"enum": ["horizontalLine", "trendLine", "polyline"]},
        "anchors": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"$ref": "#/$defs/anchor"}},
        "sourceInterval": {"$ref": "#/$defs/interval"}, "style": {"type": "object"},
        "visible": {"const": true}, "createdBy": {"const": "system"},
        "ownership": {"const": "czardas-managed"},
        "czardasLayer": {"enum": ["hline", "trend", "pattern"]},
        "sourceInferenceId": {"$ref": "#/$defs/digest"},
        "sourceCandidateId": {"type": ["string", "null"]},
        "sourceRelationId": {"type": ["string", "null"]},
        "createdAt": {"$ref": "#/$defs/timestamp"}, "updatedAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "field": {
      "type": "object",
      "required": [
        "schemaVersion", "sourceBars", "evaluationAsOf", "sourceInferenceId",
        "inputContractVersion", "inferenceConfigDigest", "projectionConfigDigest",
        "sightProjectionVersion", "sightProjectionId",
        "windowFromTimestamp", "windowToTimestamp", "candleMeanings", "structuralDomains",
        "regressionFlows", "priceMemoryRidges", "basisFacts", "hlineModes", "trendModes",
        "selectedModeRefs", "derivationEpisodes", "validationGlyphs", "patternRelationGlyphs",
        "patternEvidenceGlyphs", "projection"
      ],
      "properties": {
        "schemaVersion": {"const": 4}, "sourceBars": {"const": 240},
        "inputContractVersion": {"const": "canonical-ohlcv-q8-v1"},
        "inferenceConfigDigest": {"$ref": "#/$defs/digest"},
        "projectionConfigDigest": {"$ref": "#/$defs/digest"},
        "sightProjectionVersion": {"const": "czardas-sight-v3"},
        "sightProjectionId": {"$ref": "#/$defs/digest"},
        "evaluationAsOf": {"$ref": "#/$defs/timestamp"},
        "sourceInferenceId": {"$ref": "#/$defs/digest"},
        "windowFromTimestamp": {"$ref": "#/$defs/timestamp"},
        "windowToTimestamp": {"$ref": "#/$defs/timestamp"},
        "candleMeanings": {"type": "object"},
        "structuralDomains": {"type": "array", "items": {"type": "object"}},
        "regressionFlows": {"type": "array", "items": {"type": "object"}},
        "priceMemoryRidges": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "basisFacts": {"type": "object"}, "hlineModes": {"type": "array"},
        "trendModes": {"type": "array"}, "selectedModeRefs": {"type": "array", "maxItems": 11},
        "derivationEpisodes": {"type": "object"}, "validationGlyphs": {"type": "array"},
        "patternRelationGlyphs": {"type": "array", "maxItems": 2},
        "patternEvidenceGlyphs": {"type": "array", "maxItems": 1},
        "projection": {"type": "object"}
      }
    }
  }
}
