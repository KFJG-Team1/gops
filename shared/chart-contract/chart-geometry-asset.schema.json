{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gops.local/contracts/chart-geometry-asset.schema.json",
  "title": "GOPS Chart Geometry Asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetVersion", "algorithmVersion", "symbol", "interval", "sourceInterval", "asOf", "generatedAt", "status", "inputDigest", "coverage", "geometry", "indicators"],
  "properties": {
    "assetVersion": {"const": "geometry"},
    "algorithmVersion": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "interval": {"$ref": "#/$defs/interval"},
    "sourceInterval": {"$ref": "#/$defs/interval"},
    "asOf": {"type": "string", "format": "date-time"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "status": {"const": "ready"},
    "inputDigest": {"type": "string", "pattern": "^sha256:"},
    "coverage": {
      "type": "object",
      "required": ["state", "targetBars", "actualBars", "contiguousBars", "missingBars"],
      "properties": {
        "state": {"enum": ["full", "partial"]},
        "targetBars": {"type": "integer", "minimum": 120},
        "actualBars": {"type": "integer", "minimum": 120},
        "contiguousBars": {"type": "integer", "minimum": 120},
        "missingBars": {"type": "integer", "minimum": 0}
      }
    },
    "geometry": {
      "type": "object",
      "required": ["drawings", "supports", "resistances", "patterns", "primaryPattern", "tradePlan", "primaryTriangle", "historicalTriangle"],
      "properties": {
        "drawings": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/drawing"}},
        "supports": {"type": "array", "maxItems": 2},
        "resistances": {"type": "array", "maxItems": 2},
        "patterns": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/pattern"}},
        "primaryPattern": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pattern"}]},
        "tradePlan": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tradePlan"}]},
        "primaryTriangle": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/triangle"}]},
        "historicalTriangle": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/triangle"}]},
        "evidence": {"type": "array"}
      }
    },
    "indicators": {"type": "object"}
  },
  "$defs": {
    "interval": {"enum": ["1m", "5m", "10m", "1h", "4h", "1D", "1W"]},
    "anchor": {
      "type": "object",
      "required": ["timestamp", "price"],
      "properties": {"timestamp": {"type": "string", "format": "date-time"}, "price": {"type": "number", "exclusiveMinimum": 0}}
    },
    "drawing": {
      "type": "object",
      "required": ["id", "type", "symbol", "interval", "anchors", "sourceInterval", "style", "visible", "createdBy", "sourceProposalId", "createdAt", "updatedAt"],
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["horizontalLine", "trendLine"]},
        "symbol": {"type": "string", "minLength": 1},
        "interval": {"$ref": "#/$defs/interval"},
        "anchors": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/anchor"}},
        "sourceInterval": {"$ref": "#/$defs/interval"},
        "style": {"type": "object"},
        "visible": {"type": "boolean"},
        "createdBy": {"const": "system"},
        "sourceProposalId": {"type": "string"},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "pattern": {
      "type": "object",
      "required": ["kind", "state", "score", "geometryHash"],
      "properties": {
        "kind": {"enum": ["ascending_triangle", "descending_triangle", "symmetrical_triangle", "bullish_flag", "bearish_flag", "bullish_pennant", "bearish_pennant", "bullish_rectangle", "bearish_rectangle", "rising_wedge", "falling_wedge", "descending_channel_breakout", "ascending_channel_breakdown"]},
        "state": {"enum": ["forming", "confirmed", "inactive", "invalidated"]},
        "bias": {"enum": ["bullish", "bearish", "neutral"]},
        "breakoutDirection": {"enum": ["up", "down", null]},
        "breakoutAt": {"type": ["string", "null"], "format": "date-time"},
        "confirmedAt": {"type": ["string", "null"], "format": "date-time"},
        "confirmationMethod": {"enum": ["volume", "hold", null]},
        "volumeRatio": {"type": "number", "minimum": 0},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "geometryHash": {"type": "string"}
      }
    },
    "confirmationCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "boundary", "boundaryPrice", "triggerPrice", "bufferAtr", "rule"],
      "properties": {
        "direction": {"enum": ["up", "down"]},
        "boundary": {"enum": ["upper", "lower"]},
        "boundaryPrice": {"type": "number"},
        "triggerPrice": {"type": "number"},
        "bufferAtr": {"type": "number", "minimum": 0},
        "rule": {"enum": ["completed_close_above", "completed_close_below"]}
      }
    },
    "tradePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "symbol", "interval", "patternId", "patternKind", "patternState", "action", "direction", "signalAt", "entryTrigger", "entryPrice", "stopPrice", "targetPrice", "riskPerShare", "rewardPerShare", "rewardRiskRatio", "minimumRewardRisk", "projectionBars", "reasons"],
      "allOf": [
        {
          "if": {"properties": {"version": {"const": "pattern-trade-timing-v2"}}},
          "then": {"required": ["confirmationConditions"]}
        },
        {
          "if": {"properties": {"version": {"const": "pattern-trade-timing-v3"}}},
          "then": {"required": ["confirmationConditions", "phase", "confirmationEvidence", "entryPlan", "stopPlan", "targets", "retest"]}
        }
      ],
      "properties": {
        "version": {"enum": ["pattern-trade-timing-v1", "pattern-trade-timing-v2", "pattern-trade-timing-v3"]},
        "symbol": {"type": ["string", "null"]},
        "interval": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/interval"}]},
        "patternId": {"type": "string", "minLength": 1},
        "patternKind": {"type": "string", "minLength": 1},
        "patternState": {"type": "string", "minLength": 1},
        "action": {"enum": ["watch", "buy_candidate", "sell_candidate", "short_candidate", "no_trade"]},
        "direction": {"enum": ["long", "exit_long", "short", null]},
        "phase": {"enum": ["forming", "confirmation_pending", "confirmed", "retest_confirmed", "t1_reached", "t2_reached", "invalidated", "expired"]},
        "signalAt": {"type": ["string", "null"], "format": "date-time"},
        "entryTrigger": {"type": ["number", "null"]},
        "confirmationConditions": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/confirmationCondition"}},
        "confirmationEvidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/confirmationEvidence"}]},
        "entryPlan": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/entryPlan"}]},
        "stopPlan": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stopPlan"}]},
        "targets": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/tradeTarget"}},
        "retest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/retest"}]},
        "entryPrice": {"type": ["number", "null"]},
        "stopPrice": {"type": ["number", "null"]},
        "targetPrice": {"type": ["number", "null"]},
        "riskPerShare": {"type": ["number", "null"]},
        "rewardPerShare": {"type": ["number", "null"]},
        "rewardRiskRatio": {"type": ["number", "null"]},
        "minimumRewardRisk": {"type": "number", "minimum": 0},
        "projectionBars": {"type": "integer", "minimum": 1},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "confirmationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "boundaryPrice", "triggerPrice", "breakoutAt", "confirmedAt", "method", "volumeRatio", "requiredVolumeRatio", "holdBars"],
      "properties": {
        "direction": {"enum": ["up", "down"]},
        "boundaryPrice": {"type": "number"},
        "triggerPrice": {"type": "number"},
        "breakoutAt": {"type": "string", "format": "date-time"},
        "confirmedAt": {"type": ["string", "null"], "format": "date-time"},
        "method": {"enum": ["volume", "hold", null]},
        "volumeRatio": {"type": "number", "minimum": 0},
        "requiredVolumeRatio": {"type": "number", "minimum": 0},
        "holdBars": {"type": "integer", "minimum": 1}
      }
    },
    "entryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "at", "price"],
      "properties": {
        "mode": {"enum": ["confirmation_close", "retest_close"]},
        "at": {"type": "string", "format": "date-time"},
        "price": {"type": "number"}
      }
    },
    "stopPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialPrice", "activePrice", "basis", "bufferAtr"],
      "properties": {
        "initialPrice": {"type": "number"},
        "activePrice": {"type": "number"},
        "basis": {"enum": ["pattern_structure", "breakout_boundary_atr", "retest_swing_atr"]},
        "bufferAtr": {"type": "number", "minimum": 0}
      }
    },
    "tradeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "price", "basis", "allocationPercent", "rMultiple"],
      "properties": {
        "id": {"enum": ["T1", "T2"]},
        "price": {"type": "number"},
        "basis": {"enum": ["one_r", "nearest_opposing_level", "measured_move"]},
        "allocationPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "rMultiple": {"type": "number", "minimum": 0}
      }
    },
    "retest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "at", "zoneLow", "zoneHigh", "observedBars", "maxBars"],
      "properties": {
        "state": {"enum": ["pending", "confirmed", "expired"]},
        "at": {"type": ["string", "null"], "format": "date-time"},
        "zoneLow": {"type": ["number", "null"]},
        "zoneHigh": {"type": ["number", "null"]},
        "observedBars": {"type": "integer", "minimum": 0},
        "maxBars": {"type": "integer", "minimum": 1}
      }
    },
    "triangle": {
      "type": "object",
      "required": ["kind", "state", "score", "geometryHash"],
      "properties": {
        "kind": {"enum": ["ascending_triangle", "descending_triangle", "symmetrical_triangle"]},
        "state": {"enum": ["forming", "confirmed", "inactive", "invalidated"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "geometryHash": {"type": "string"}
      }
    }
  }
}
